__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/

# data and weights never go in git
# Anchored with a leading slash: a bare `data/` also matches src/sih/data/,
# which silently kept the whole data package out of git.
/data/
/checkpoints/
*.safetensors
*.bin
*.pt
*.tif
*.tar

# results JSON DOES go in git — that is the audit trail
!results/*.json
results/_smoke_ckpt/
/runs/
