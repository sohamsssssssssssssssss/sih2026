__pycache__/
*.py[cod]
.venv/
.venv-stage1/
node_modules/
.next/
/frontend/tsconfig.tsbuildinfo
/frontend/.env.local
trace.jsonl
# Anchored: a bare `results.json` also matches results/results.json and
# would silently swallow the committed audit trail in results/.
/results.json
/outputs/
.DS_Store
# Anchored to the repo root. A bare `data/raw/` also matches any nested
# data/raw at any depth — the unanchored-pattern bug that twice hid real work.
/data/raw/
/data/ladder/*
!/data/ladder/0.3/
/data/ladder/0.3/*
!/data/ladder/0.3/loveda_Train_Rural_images_png_0_gsd0.3.png
/data/sar_gate/jobs.json
/data/sar_gate/raw/
/data/sar_gate/rendered/
/data/runtime/
# Derived Stage-1 training shards (loop 8). One 2,000-patch shard is 320 MB and a
# full-train build is ~68 GB of derived pixels; the manifest under
# data/manifests/ is the record that travels, not the pixels. Anchored so the
# tracked data/ package is untouched.
data/shards/
# Build logs from long CPU stream passes.
/logs/

# Datasets never go in git. The BigEarthNet.txt parquet (467 MB) lives at
# ~/data/bigearthnet_txt/ — outside the repo entirely, which is what actually
# keeps it out. This is the belt-and-braces guard for a stray copy.
# NOTE: do NOT write `/data/` here. The repo's own data/ package is tracked
# source (dataset.py, download_ladder_data.py, sar_gate/, BEN_TXT_FACTS.md);
# ignoring it would hide real files, which is the exact bug this repo has hit.
*.parquet
*.tar.gz*
*.tar.zst

# Personal reference, not for distribution. Anchored to the repo root.
/PROJECT_OVERVIEW.pdf

# Coverage runtime artifact. The plan requires that no runtime artifact is ever
# accidentally committed; this is one both CI and local runs produce.
.coverage
.coverage.*

# TypeScript incremental build cache, regenerated by every `next build`.
frontend/tsconfig.tsbuildinfo
frontend/public/videos/satquery-intro-original.mp4

/data/external/
