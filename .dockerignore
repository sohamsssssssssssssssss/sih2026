# Build context for Dockerfile.backend (repo root). The frontend has its own
# context (frontend/) and .dockerignore, so it is excluded here entirely.
.git
.github
.claude
.streamlit
**/__pycache__
**/*.py[cod]
**/.pytest_cache
.venv
**/.venv
.venv-stage1/
**/.venv-stage1/
packages/
**/packages/
.coverage
.coverage.*
.DS_Store

frontend/

# Runtime state lives in volumes, never in an image layer.
trace.jsonl
trace.jsonl.*
data/runtime/
deploy/state/

# Local caches and generated content
**/.cache/
**/.mypy_cache/
**/.ruff_cache/
**/node_modules/
**/*.egg-info/
**/dist/
**/build/
**/*.whl
*.log
*.tmp
*.temp

# Credentials and environment files
.env
.env.*
**/.env
**/.env.*
**/credentials/
**/secrets/

# Runtime artifacts and captures
**/probe-captures/
**/captures/
**/artifacts/
**/outputs/
**/trace.jsonl*
**/*.tif
**/*.tiff
**/*.jsonl
# Narrow the broad JSONL exclusion above: the tracked evaluation set is a
# required build input. Runtime traces (trace.jsonl*, **/trace.jsonl*) and
# generated JSONL remain excluded.
!data/eval/questions.v1.jsonl
**/*.sqlite
**/*.sqlite3
**/*.db

# Weights and datasets are mounted read-only at run time, never baked in.
models-artifacts/
**/*.pth
**/*.safetensors
**/*.bin
**/*.parquet
**/*.tar.gz*
**/*.tar.zst
data/raw/
data/external/
data/sar_gate/raw/

# Not needed by the API or the GPU smoke.
docs/
reviews/
kaggle/
training/
outputs/
PROJECT_OVERVIEW.pdf
