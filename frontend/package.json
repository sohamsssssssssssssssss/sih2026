{
  "name": "satquery-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy-maplibre-worker": "mkdir -p public/maplibre && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs node_modules/maplibre-gl/dist/maplibre-gl-shared.mjs public/maplibre/",
    "predev": "npm run copy-maplibre-worker",
    "dev": "next dev",
    "prebuild": "npm run copy-maplibre-worker",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "animejs": "^4.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.41.0",
    "maplibre-gl": "6.7.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "tailwind-merge": "3.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "10.5.5",
    "jsdom": "^25.0.1",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "typescript": "7.0.2",
    "vitest": "^3.2.7"
